# PoolPay AI Environment Configuration
# Copy to .env and update values

# Razorpay Test Mode Keys (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to "false" to use real Razorpay keys
MOCK_RAZORPAY=true

# Demo mode enables demo control endpoints
DEMO_MODE=true

# Database
DATABASE_URL=sqlite:///./poolpay.db
